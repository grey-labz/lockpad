# Public testnet configuration. Local `npm run demo` needs no credentials.
VITE_NETWORK=testnet
VITE_MARKET_ACCOUNT=
VITE_VAULT_ACCOUNT=
VITE_TOKEN_ACCOUNT=
VITE_POOL_ACCOUNT=
VITE_NEAR_RPC=https://test.rpc.fastnear.com

# Optional: local demo port. The server binds to 127.0.0.1.
LOCKPAD_DEMO_PORT=5273

# Deployment CLI only; private credentials must be outside this repository.
# LOCKPAD_TESTNET_KEYS=/absolute/path/to/private/lockpad-testnet-keys
