{
  "name": "lockpad",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Borrow against an eligible locked position or sell its payout right on NEAR.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/demo-server.mjs",
    "demo": "node scripts/demo-server.mjs",
    "dev:testnet": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "contracts:build": "node scripts/build-contracts.mjs",
    "test": "node scripts/unit-tests.mjs",
    "test:contracts": "node scripts/contract-tests.mjs",
    "test:lending": "node scripts/lending-tests.mjs",
    "test:e2e": "node scripts/browser-test.mjs",
    "test:release": "node scripts/release-tests.mjs",
    "release:plan": "node scripts/deploy.mjs",
    "release:preflight": "node scripts/deploy.mjs --preflight",
    "release:deploy": "node scripts/deploy.mjs",
    "release:account": "node scripts/create-release-account.mjs",
    "release:verify": "node scripts/verify-testnet.mjs",
    "release:trade": "node scripts/testnet-demo.mjs",
    "release:build": "node scripts/build-testnet.mjs",
    "release:bundle": "node scripts/package-release.mjs",
    "submission:bundle": "node scripts/package-submission.mjs",
    "verify": "npm test && npm run contracts:build && npm run test:contracts && npm run test:lending && npm run test:release && npm run build && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "near-api-js": "^5.1.1",
    "near-workspaces": "^5.0.0",
    "playwright": "^1.65.0"
  },
  "overrides": {
    "tar": "^7.5.23"
  }
}
